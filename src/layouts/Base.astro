---
import { base } from '../lib';
const { title = 'Гриби Шульгівки' } = Astro.props;
---
<html lang="uk"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title><link rel="manifest" href={`${base}/manifest.webmanifest`}><meta name="theme-color" content="#1f3a2a"></head>
<body data-base={base}>
<div class="warn" role="note"><b>☠ Це не визначник для збору та вживання.</b> Ніколи не їжте гриб лише на підставі цього сайту.</div>
<header><a class="logo" href={`${base}/`}>Гриби Шульгівки</a><nav><a href={`${base}/`}>Гриби</a><a href={`${base}/map/`}>Мапа</a></nav><span id="offline" hidden>✓ Доступно офлайн</span></header>
<main><slot /></main>
<script>
  const b = document.body.dataset.base;
  if ('serviceWorker' in navigator) navigator.serviceWorker.register(`${b}/sw.js`).then(async () => {
    await navigator.serviceWorker.ready;
    const urls: string[] = await (await fetch(`${b}/precache.json`)).json();
    performance.getEntriesByType('resource').forEach(r => r.name.startsWith(location.origin) && urls.push(r.name));
    const c = await caches.open('hs-v1');
    await Promise.all(urls.map(u => c.add(u).catch(() => {})));
    document.getElementById('offline')!.hidden = false;
  }).catch(() => {});
</script>
<style is:global>
  :root { --ink:#1f2a1c; --moss:#1f3a2a; --lichen:#e9eee6; --line:#c5cfbf; }
  * { box-sizing: border-box } body { margin:0; background:var(--lichen); color:var(--ink); font:18px/1.6 Charter,'Iowan Old Style',Georgia,serif }
  .warn { background:#b3261e; color:#fff; padding:.6rem 1rem; text-align:center; font-size:.95rem }
  header { display:flex; flex-wrap:wrap; gap:.5rem 1.5rem; align-items:baseline; padding:1rem; border-bottom:2px solid var(--moss) }
  .logo { font-size:1.6rem; font-weight:700; color:var(--moss); text-decoration:none } nav { display:flex; gap:1rem; flex:1 } a { color:var(--moss) }
  #offline { font-size:.85rem } main { max-width:1100px; margin:0 auto; padding:1rem }
  .tools { display:flex; gap:.5rem; margin-bottom:1rem } .tools input,.tools select { font:inherit; padding:.5rem; border:1px solid var(--moss); background:#fff; border-radius:2px } .tools input { flex:1; min-width:0 }
  .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:1.2rem 1rem }
  .card { text-decoration:none; color:inherit; display:block } .card img,.ph { width:100%; aspect-ratio:1; object-fit:cover; border-radius:2px; display:block; background:var(--line) }
  .ph { display:grid; place-items:center; font-size:3rem } .meta { display:grid; gap:.1rem; padding-top:.4rem } .meta i { font-size:.9rem; opacity:.8 }
  .tag { color:#fff; padding:.05rem .5rem; border-radius:2px; font:600 .8rem/1.6 system-ui,sans-serif; justify-self:start }
  .gallery { display:flex; gap:.5rem; overflow-x:auto } .gallery img { height:280px; border-radius:2px }
  dl { display:grid; grid-template-columns:max-content 1fr; gap:.3rem 1rem } dt { font-weight:700 }
  .map { height:340px; margin:1rem 0; border-radius:2px } .map[hidden] { display:none } ul.pts { font-size:.95rem; padding-left:1.2rem }
</style></body></html>
